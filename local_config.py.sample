# local_config.py.sample - copy this to local_config.py and fill in your own values.
#
# local_config.py is gitignored and imported by config.py at startup via
# `from local_config import *` (see config.py's "LOCAL OVERRIDES" section), so
# anything set here overrides the tracked default of the same name for this one
# machine, without ever showing up as a diff.
#
# Any name from config.py can be overridden this way, but these three are the
# ones actually meant to live here - see docs/ADMIN-CONSOLE.md for the full
# setup guide.

# Empty list = console disabled, and every DCC CHAT request is ignored.
#
# Each entry is a HOST pattern - the part after the last "@" of an IRC
# hostmask. On Undernet, log into X and set usermode +x, and the server
# replaces your host with "<your-account>.users.undernet.org". That is what
# goes here, not your nick.
ADMIN_HOSTMASKS = [""]

# Generate with:  python adminchat.py
ADMIN_PASSWORD_HASH = ""

# How the DCC CHAT connection gets made:
#
#   "auto"     dial the client, and listen instead if that fails.  (default)
#   "listen"   always listen and offer the connection back.
#   "connect"  only ever dial the client; never listen.
#
# "auto" is right for most setups. Choose "listen" when the client is behind a
# VPN, a router that does not forward the port, or a firewall that drops
# rather than rejects - all of which show up as a TIMEOUT on the dial and then
# cost the full connect timeout on every login before the fallback takes over.
ADMIN_CHAT_MODE = "listen"
